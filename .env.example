NODE_ENV=development
PORT=3000
APP_NAME=Haat
APP_URL=http://localhost:3000

# MongoDB Atlas free tier (M0) - transactions need a replica set, Atlas provides one
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/haat?retryWrites=true&w=majority

# Redis free tier (Upstash / Redis Cloud). Optional: the app degrades gracefully without it.
# Optional. Leave unset to run without Redis.
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# SMTP for registered-user password reset links (links expire after five minutes)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
# 'lax' for same-origin panels. Use 'none' if a React app on another origin relies on cookies.
COOKIE_SAMESITE=lax

# Comma separated origins allowed to call the authenticated API (React / React Native web)
CORS_ORIGINS=http://localhost:5173
STOREFRONT_URL=http://localhost:5173

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

DELIVERY_FEE_PAISE=3000
PENDING_ORDER_TTL_MIN=20
RETURN_WINDOW_DAYS=7

# Used by npm run seed:admin
ADMIN_EMAIL=admin@haat.local
ADMIN_PASSWORD=ChangeMe#2026
