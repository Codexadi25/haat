<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= appName %></title>
  <% if (gaMeasurementId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaMeasurementId %>" nonce="<%= nonce %>"></script>
    <script nonce="<%= nonce %>">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= gaMeasurementId %>');
    </script>
  <% } %>
  <script nonce="<%= nonce %>">try{var t=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="<%= bodyClass %>">
  <%- include('partials/icons') %>
  <%- body %>
  <script src="/js/theme.js" defer></script>
  <% if (typeof scripts !== 'undefined') { scripts.forEach(function (s) { %><script src="<%= s %>" defer></script><% }) } %>
</body>
</html>
